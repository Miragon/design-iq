{
  "name": "@designiq/ui-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared shadcn (new-york) UI kit + the Miragon CI theme (vendored --cd-* tokens, semantic aliases, Geist) for the designIQ SPAs and widgets — raw .tsx/.css sources consumed directly by Vite, no build step. react/react-dom are peerDependencies: pnpm auto-installs them and both SPAs pin the same range, guaranteeing a single React instance.",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./theme.css": "./src/theme.css",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.51.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
